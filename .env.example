# Copy this to .env (or export these directly) before running server.py

# Your Tableau Cloud pod URL (from your link: 10ax pod)
TABLEAU_SERVER_URL=https://10ax.online.tableau.com

# The content-url of your site (from your link: personalsandboxpp)
TABLEAU_SITE=personalsandboxpp

# Create these under: Tableau > Account Settings > Personal Access Tokens
TABLEAU_TOKEN_NAME=your-token-name
TABLEAU_TOKEN_SECRET=your-token-secret
