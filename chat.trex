<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <dashboard-extension id="com.personalsandbox.tableau-mcp-chat" extension-version="0.1.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Ask questions about your Tableau content using an MCP-powered assistant.</description>
    <author name="Prateek Pathak" email="prateek_pathak@hotmail.com" organization="Personal" website="https://www.linkedin.com/in/prateekpathak/"/>
    <min-api-version>1.4</min-api-version>
    <source-location>
      <!-- Replace with your HTTPS tunnel/host URL -->
      <!--<url>http://localhost:8000/index.html</url>-->
      <url>https://ai-assistant-for-tableaudashboard.onrender.com/index.html</url>
    </source-location>
    <icon/>
  </dashboard-extension>
  <resources>
    <resource id="name">
      <text locale="en_US">Tableau MCP Chat</text>
    </resource>
  </resources>
</manifest>
